{
  "name": "plinko",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern Plinko game built with BabylonJS and Rapier3D",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:gh-pages": "npm run build && gh-pages -d dist",
    "postbuild": "node scripts/postbuild.cjs"
  },
  "devDependencies": {
    "terser": "^5.44.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "@babylonjs/core": "^7.37.1",
    "@dimforge/rapier3d-compat": "^0.14.0"
  }
}
